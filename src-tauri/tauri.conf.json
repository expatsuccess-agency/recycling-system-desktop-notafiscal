{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recycling System Industrial V8-NotaFiscal",
  "version": "8.2.0",
  "identifier": "br.com.lxo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.1.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Recycling System Industrial",
        "width": 1360,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "maximized": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "nsis"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
